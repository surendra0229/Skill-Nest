# ==========================================
# 1. APPLICATION & DEPLOYMENT (Next.js 15 / Vercel)
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ==========================================
# 2. DATABASE & STORAGE (Supabase PostgreSQL + Drizzle ORM)
# ==========================================
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==========================================
# 3. AUTHENTICATION (Auth.js v5 / NextAuth)
# ==========================================
AUTH_SECRET="your-super-secret-auth-js-key-here"
AUTH_TRUST_HOST="true"

# Google OAuth (Callback: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth (Callback: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ==========================================
# 4. TRANSACTIONAL EMAILS (Resend)
# ==========================================
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Skill Nest <onboarding@resend.dev>"

# ==========================================
# 5. CACHE & BACKGROUND JOBS (Redis & BullMQ)
# ==========================================
REDIS_URL="redis://localhost:6379"

# ==========================================
# 6. EXTERNAL APIs (Judge0, JSearch, YouTube, OpenAI)
# ==========================================
# RapidAPI (Judge0 Code Execution & JSearch Jobs)
RAPIDAPI_KEY="your-rapidapi-key"
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JSEARCH_API_HOST="jsearch.p.rapidapi.com"
JSEARCH_API_URL="https://jsearch.p.rapidapi.com"

# YouTube Data API v3
YOUTUBE_API_KEY="your-youtube-data-api-key"

# OpenAI API (AI Tutor & Explanations)
OPENAI_API_KEY="sk-your-openai-api-key"

# ==========================================
# 7. MEDIA OPTIMIZATION (Cloudinary)
# ==========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
